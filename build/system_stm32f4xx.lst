  40:src/system_stm32f4xx.c **** /**
  41:src/system_stm32f4xx.c ****  * @brief  Update SystemCoreClock variable according to Clock Register Values.
  42:src/system_stm32f4xx.c ****  *         The SystemCoreClock variable contains the core clock (HCLK), it can
  43:src/system_stm32f4xx.c ****  *         be used by the user application to setup the SysTick timer or configure
  44:src/system_stm32f4xx.c ****  *         other parameters.
  45:src/system_stm32f4xx.c ****  *
  46:src/system_stm32f4xx.c ****  * @note   Each time the core clock (HCLK) changes, this function must be called
  47:src/system_stm32f4xx.c ****  *         to update SystemCoreClock variable value. Otherwise, any configuration
  48:src/system_stm32f4xx.c ****  *         based on this variable will be incorrect.
  49:src/system_stm32f4xx.c ****  *
  50:src/system_stm32f4xx.c ****  * @note   - The system frequency computed by this function is not the real
  51:src/system_stm32f4xx.c ****  *           frequency in the chip. It is calculated based on the predefined
  52:src/system_stm32f4xx.c ****  *           constant and the selected clock source:
  53:src/system_stm32f4xx.c ****  *
  54:src/system_stm32f4xx.c ****  *           - If SYSCLK source is HSI, SystemCoreClock will contain the HSI_VALUE(*)
  55:src/system_stm32f4xx.c ****  *
  56:src/system_stm32f4xx.c ****  *           - If SYSCLK source is HSE, SystemCoreClock will contain the HSE_VALUE(**)
  57:src/system_stm32f4xx.c ****  *
  58:src/system_stm32f4xx.c ****  *           - If SYSCLK source is PLL, SystemCoreClock will contain the HSE_VALUE(**)
  59:src/system_stm32f4xx.c ****  *             or HSI_VALUE(*) multiplied/divided by the PLL factors.
  60:src/system_stm32f4xx.c ****  *
ARM GAS  C:\Users\nekita\AppData\Local\Temp\ccFUxbnD.s 			page 3


  61:src/system_stm32f4xx.c ****  *         (*) HSI_VALUE is a constant defined in stm32f4xx_hal_conf.h file (default value
  62:src/system_stm32f4xx.c ****  *             16 MHz) but the real value may vary depending on the variations
  63:src/system_stm32f4xx.c ****  *             in voltage and temperature.
  64:src/system_stm32f4xx.c ****  *
  65:src/system_stm32f4xx.c ****  *         (**) HSE_VALUE is a constant defined in stm32f4xx_hal_conf.h file (its value
  66:src/system_stm32f4xx.c ****  *              depends on the application requirements), user has to ensure that HSE_VALUE
  67:src/system_stm32f4xx.c ****  *              is same as the real frequency of the crystal used. Otherwise, this function
  68:src/system_stm32f4xx.c ****  *              may have wrong result.
  69:src/system_stm32f4xx.c ****  *
  70:src/system_stm32f4xx.c ****  *         - The result of this function could be not correct when using fractional
  71:src/system_stm32f4xx.c ****  *           value for HSE crystal.
  72:src/system_stm32f4xx.c ****  *
  73:src/system_stm32f4xx.c ****  * @param  None
  74:src/system_stm32f4xx.c ****  * @retval None
  75:src/system_stm32f4xx.c ****  */
  76:src/system_stm32f4xx.c **** void SystemCoreClockUpdate(void)
